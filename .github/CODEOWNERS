# Branch protection ("Require review from Code Owners") turns this into the
# approval gate. Replace the placeholders with real GitHub users or teams.

# Request files: the approving manager(s).
/requests/                     <approver-github-user-or-@org/team>

# Everything that defines HOW VMs are built or approved: the platform owner(s).
# Keeping these separate stops an approver from changing the rules in a request PR.
/modules/                      <platform-owner-github-user-or-@org/team>
/stacks/                       <platform-owner-github-user-or-@org/team>
/bootstrap/                    <platform-owner-github-user-or-@org/team>
/scripts/                      <platform-owner-github-user-or-@org/team>
/.github/                      <platform-owner-github-user-or-@org/team>
